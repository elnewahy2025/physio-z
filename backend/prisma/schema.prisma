generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                        String                 @id @default(cuid())
  name                                      String
  phone                                     String                 @unique
  email                                     String?                @unique
  passwordHash                              String
  role                                      Role                   @default(PATIENT)
  isActive                                  Boolean                @default(true)
  createdAt                                 DateTime               @default(now())
  updatedAt                                 DateTime               @updatedAt
  isDeleted                                 Boolean                @default(false)
  appointments                              Appointment[]          @relation("AppointmentTherapist")
  AuditLog                                  AuditLog[]             @relation("AuditUser")
  blockedSlots                              BlockedSlot[]
  prescriptionsCreated                      ExercisePrescription[] @relation("PrescriptionTherapist")
  expensesCreated                           Expense[]              @relation("ExpenseCreator")
  Expense_Expense_staffIdToUser             Expense[]              @relation("Expense_staffIdToUser")
  filesUploaded                             File[]                 @relation("FileUploader")
  IncidentReport                            IncidentReport[]       @relation("IncidentReporter")
  inventoryRecords                          InventoryTransaction[] @relation("InventoryRecorder")
  invoicesCreated                           Invoice[]              @relation("InvoiceCreator")
  maintenanceRecords                        MaintenanceLog[]       @relation("MaintenanceRecorder")
  MedicalFile                               MedicalFile[]          @relation("MedicalFileUploader")
  notifications                             Notification[]         @relation("UserNotifications")
  patient                                   Patient?               @relation("PatientAccount")
  packagesSold                              PatientPackage[]       @relation("PackageSeller")
  paymentsConfirmed                         PaymentReference[]     @relation("PaymentConfirmer")
  photosTaken                               ProgressPhoto[]        @relation("PhotoTaker")
  therapistRatings                          Rating[]               @relation("TherapistRatings")
  StaffSalary_StaffSalary_createdByIdToUser StaffSalary[]          @relation("StaffSalary_createdByIdToUser")
  StaffSalary_StaffSalary_userIdToUser      StaffSalary[]          @relation("StaffSalary_userIdToUser")
  surveyTherapist                           Survey[]               @relation("SurveyTherapist")
  therapySessions                           TherapySession[]       @relation("SessionTherapist")
  UserActivity                              UserActivity[]         @relation("UserActivity")
  videosCreated                             VideoConsultation[]    @relation("VideoCreator")
  waitlistTherapist                         WaitlistEntry[]        @relation("WaitlistTherapist")
  whatsappSent                              WhatsAppReminderLog[]  @relation("WhatsAppSender")
}

model Patient {
  id                       String                   @id @default(cuid())
  name                     String
  phone                    String
  email                    String?
  address                  String?
  dateOfBirth              DateTime?
  medicalHistory           String?
  userId                   String?                  @unique
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  allergies                String[]
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  gender                   String?
  appointments             Appointment[]
  ConsentForm              ConsentForm[]
  exercisePrescriptions    ExercisePrescription[]
  files                    File[]
  IncidentReport           IncidentReport[]
  insuranceClaims          InsuranceClaim[]
  intakeForms              IntakeForm[]
  invoices                 Invoice[]
  loyaltyProfile           LoyaltyProfile?
  LoyaltyTransaction       LoyaltyTransaction[]
  MedicalFile              MedicalFile[]
  PainMap                  PainMap[]
  user                     User?                    @relation("PatientAccount", fields: [userId], references: [id])
  patientBadges            PatientBadge[]
  PatientEducation         PatientEducation[]
  insurancePolicies        PatientInsurancePolicy[]
  patientOtps              PatientOTP[]
  patientPackages          PatientPackage[]
  ProgressPhoto            ProgressPhoto[]
  ratings                  Rating[]                 @relation("PatientRatings")
  surveys                  Survey[]
  waitlistEntries          WaitlistEntry[]
}

model Room {
  id           String        @id @default(cuid())
  number       Int           @unique
  name         String
  appointments Appointment[]
  equipment    Equipment[]
}

model Appointment {
  id                    String                 @id @default(cuid())
  patientId             String
  therapistId           String
  roomId                String?
  dateTime              DateTime
  duration              Int                    @default(45)
  status                AppointmentStatus      @default(PENDING)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  recurringPatternId    String?
  videoLink             String?
  patient               Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  room                  Room?                  @relation(fields: [roomId], references: [id])
  therapist             User                   @relation("AppointmentTherapist", fields: [therapistId], references: [id])
  exercisePrescriptions ExercisePrescription[]
  insuranceClaims       InsuranceClaim[]
  invoices              Invoice[]
  MedicalFile           MedicalFile[]
  PainMap               PainMap[]
  ProgressPhoto         ProgressPhoto[]
  rating                Rating?                @relation("AppointmentRating")
  survey                Survey?                @relation("AppointmentSurvey")
  therapySessions       TherapySession[]
  videoConsultations    VideoConsultation[]
  whatsappReminders     WhatsAppReminderLog[]

  @@index([dateTime])
  @@index([therapistId, dateTime])
  @@index([patientId, dateTime])
  @@index([status, dateTime])
}

model TherapySession {
  id            String      @id @default(cuid())
  appointmentId String
  therapistId   String
  diagnosis     String
  treatmentPlan String?
  notes         String?
  duration      Int
  painLevel     Int?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  therapist     User        @relation("SessionTherapist", fields: [therapistId], references: [id])

  @@index([appointmentId])
}

model Invoice {
  id                String             @id @default(cuid())
  number            String             @unique
  patientId         String
  appointmentId     String?
  amount            Decimal            @db.Decimal(10, 2)
  tax               Decimal            @default(0) @db.Decimal(10, 2)
  total             Decimal            @db.Decimal(10, 2)
  dueDate           DateTime?
  status            InvoiceStatus      @default(UNPAID)
  paymentMethod     PaymentMethod?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  insuranceClaims   InsuranceClaim[]
  appointment       Appointment?       @relation(fields: [appointmentId], references: [id])
  createdBy         User               @relation("InvoiceCreator", fields: [createdById], references: [id])
  patient           Patient            @relation(fields: [patientId], references: [id])
  payments          Payment[]
  paymentReferences PaymentReference[]

  @@index([patientId, status])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  status        PaymentStatus @default(COMPLETED)
  transactionId String?
  paymentDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model PaymentGateway {
  id        String   @id @default(cuid())
  name      String
  provider  String
  isActive  Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                      String   @id
  centerName              String
  centerLogo              String?
  address                 String?
  phone                   String?
  email                   String?
  googleMapsLink          String?
  workingHours            Json?
  sessionPrice            Decimal  @db.Decimal(10, 2)
  currency                String   @default("EGP")
  taxRate                 Decimal  @default(0) @db.Decimal(5, 2)
  defaultLanguage         String   @default("ar")
  whatsappMessageTemplate String?
  updatedAt               DateTime @updatedAt
  bankAccountName         String?
  bankAccountNumber       String?
  bankName                String?
  instapayHandle          String?
  myFawryMerchantCode     String?
  paymentExpiryHours      Int      @default(24)
  enabledFeatures         Json?
  maxConcurrentRooms      Int      @default(5)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Rating {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  patientId     String
  therapistId   String
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation("AppointmentRating", fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient     @relation("PatientRatings", fields: [patientId], references: [id])
  therapist     User        @relation("TherapistRatings", fields: [therapistId], references: [id])

  @@index([therapistId])
  @@index([patientId])
}

model File {
  id           String   @id @default(cuid())
  filename     String
  mimeType     String
  size         Int
  data         String
  category     String
  uploadedById String
  patientId    String?
  createdAt    DateTime @default(now())
  patient      Patient? @relation(fields: [patientId], references: [id])
  uploadedBy   User     @relation("FileUploader", fields: [uploadedById], references: [id])

  @@index([category])
  @@index([patientId])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("PENDING")
  scheduledAt DateTime
  executedAt  DateTime?
  payload     Json?
  result      Json?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt])
  @@index([type, scheduledAt])
}

model BlockedSlot {
  id           String    @id @default(cuid())
  userId       String
  dayOfWeek    Int
  startTime    String
  endTime      String
  reason       String?
  isRecurring  Boolean   @default(true)
  specificDate DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId, dayOfWeek])
}

model Expense {
  id                         String   @id @default(cuid())
  category                   String
  description                String
  amount                     Decimal  @db.Decimal(10, 2)
  date                       DateTime
  paymentMethod              String?
  notes                      String?
  createdById                String
  createdAt                  DateTime @default(now())
  staffId                    String?
  createdBy                  User     @relation("ExpenseCreator", fields: [createdById], references: [id])
  User_Expense_staffIdToUser User?    @relation("Expense_staffIdToUser", fields: [staffId], references: [id])

  @@index([date])
  @@index([category])
}

model Survey {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  patientId     String
  therapistId   String
  rating        Int
  feedback      String?
  submittedAt   DateTime    @default(now())
  appointment   Appointment @relation("AppointmentSurvey", fields: [appointmentId], references: [id], onDelete: Cascade)
  patient       Patient     @relation(fields: [patientId], references: [id])
  therapist     User        @relation("SurveyTherapist", fields: [therapistId], references: [id])

  @@index([therapistId])
  @@index([patientId])
}

model RecurringPattern {
  id                  String    @id @default(cuid())
  frequency           String
  daysOfWeek          Int[]
  sessionCount        Int
  startDate           DateTime
  endDate             DateTime?
  parentAppointmentId String?
  createdAt           DateTime  @default(now())
}

model Package {
  id              String           @id @default(cuid())
  name            String
  description     String?
  sessionCount    Int
  price           Decimal          @db.Decimal(10, 2)
  durationDays    Int?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  patientPackages PatientPackage[]
}

model PatientPackage {
  id            String    @id @default(cuid())
  patientId     String
  packageId     String
  sessionsUsed  Int       @default(0)
  sessionsTotal Int
  purchasePrice Decimal   @db.Decimal(10, 2)
  purchaseDate  DateTime  @default(now())
  expiryDate    DateTime?
  status        String    @default("ACTIVE")
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User      @relation("PackageSeller", fields: [createdById], references: [id])
  package       Package   @relation(fields: [packageId], references: [id])
  patient       Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, status])
  @@index([status, expiryDate])
}

model Discount {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  type      String
  value     Decimal   @db.Decimal(10, 2)
  minAmount Decimal?  @db.Decimal(10, 2)
  maxUses   Int?
  usedCount Int       @default(0)
  startsAt  DateTime
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([code, isActive])
}

model WaitlistEntry {
  id                  String    @id @default(cuid())
  patientId           String
  preferredDate       DateTime
  preferredTimeStart  String
  preferredTimeEnd    String
  therapistId         String?
  priority            Int       @default(0)
  status              String    @default("WAITING")
  notifiedAt          DateTime?
  bookedAppointmentId String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  patient             Patient   @relation(fields: [patientId], references: [id])
  therapist           User?     @relation("WaitlistTherapist", fields: [therapistId], references: [id])

  @@index([status, preferredDate])
  @@index([patientId])
}

model InventoryItem {
  id           String                 @id @default(cuid())
  name         String
  category     String
  unit         String
  quantity     Int                    @default(0)
  minQuantity  Int                    @default(5)
  maxQuantity  Int                    @default(100)
  unitCost     Decimal?               @db.Decimal(10, 2)
  supplier     String?
  location     String?
  notes        String?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  transactions InventoryTransaction[]

  @@index([category])
  @@index([isActive, quantity])
}

model InventoryTransaction {
  id           String        @id @default(cuid())
  itemId       String
  type         String
  quantity     Int
  reason       String?
  date         DateTime      @default(now())
  recordedById String
  createdAt    DateTime      @default(now())
  item         InventoryItem @relation(fields: [itemId], references: [id])
  recordedBy   User          @relation("InventoryRecorder", fields: [recordedById], references: [id])

  @@index([itemId, date])
}

model Equipment {
  id                      String           @id @default(cuid())
  name                    String
  category                String
  serialNumber            String?
  roomId                  String?
  purchaseDate            DateTime?
  purchaseCost            Decimal?         @db.Decimal(10, 2)
  lastMaintenanceDate     DateTime?
  maintenanceIntervalDays Int?
  status                  String           @default("ACTIVE")
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  room                    Room?            @relation(fields: [roomId], references: [id])
  maintenanceLogs         MaintenanceLog[]

  @@index([status])
}

model MaintenanceLog {
  id          String    @id @default(cuid())
  equipmentId String
  type        String
  description String
  cost        Decimal?  @db.Decimal(10, 2)
  performedBy String?
  date        DateTime
  nextDueDate DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("MaintenanceRecorder", fields: [createdById], references: [id])
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId, date])
}

model ServiceProvider {
  id                 String               @id @default(cuid())
  name               String
  providerType       ProviderType
  providerSubtype    String?
  description        String?
  isActive           Boolean              @default(true)
  isDefault          Boolean              @default(false)
  priority           Int                  @default(100)
  baseUrl            String
  apiVersion         String?
  authMethod         AuthMethod           @default(BEARER_TOKEN)
  credentials        String
  requestConfig      Json
  webhookUrl         String?
  webhookSecret      String?
  settings           Json?
  lastTestedAt       DateTime?
  lastTestSuccess    Boolean?
  totalRequests      Int                  @default(0)
  successfulRequests Int                  @default(0)
  failedRequests     Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  capabilities       ProviderCapability[]
  usageLogs          ProviderUsageLog[]

  @@unique([name, providerType])
  @@index([providerType, isActive, priority])
  @@index([isDefault])
}

model ProviderCapability {
  id              String          @id @default(cuid())
  providerId      String
  capability      String
  name            String
  endpoint        String
  method          String
  requestTemplate Json
  responseMapping Json
  errorMapping    Json
  timeout         Int             @default(30000)
  retries         Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  provider        ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, capability])
  @@index([capability])
}

model ProviderUsageLog {
  id           String          @id @default(cuid())
  providerId   String
  capability   String
  success      Boolean
  errorMessage String?
  duration     Int?
  createdAt    DateTime        @default(now())
  provider     ServiceProvider @relation(fields: [providerId], references: [id])

  @@index([providerId, createdAt])
  @@index([success, createdAt])
}

model ProviderTemplate {
  id                   String       @id @default(cuid())
  name                 String
  providerType         ProviderType
  providerSubtype      String
  description          String
  baseUrl              String
  authMethod           AuthMethod
  credentialsTemplate  Json
  capabilitiesTemplate Json
  settingsTemplate     Json
  icon                 String?
  category             String
  isPopular            Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([name, providerType])
  @@index([providerType])
  @@index([category])
}

model Exercise {
  id                String               @id @default(cuid())
  name              String
  nameAr            String
  category          ExerciseCategory
  difficulty        ExerciseDifficulty   @default(BEGINNER)
  description       String
  descriptionAr     String
  instructions      String
  instructionsAr    String
  startingPosition  String?
  endingPosition    String?
  position          ExercisePosition?
  imageUrl          String?
  videoUrl          String?
  animationUrl      String?
  defaultSets       Int                  @default(3)
  defaultReps       Int                  @default(10)
  defaultHoldTime   Int?
  defaultRestTime   Int                  @default(60)
  estimatedTime     Int?
  contraindications String?
  precautions       String?
  commonErrors      String?
  progressions      String?
  regressions       String?
  tags              String[]
  bodyParts         String[]
  equipment         String[]
  isFavorite        Boolean              @default(false)
  isActive          Boolean              @default(true)
  usageCount        Int                  @default(0)
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  assignments       ExerciseAssignment[]

  @@index([category, difficulty])
  @@index([name])
  @@index([nameAr])
  @@index([isActive])
  @@index([bodyParts])
  @@index([tags])
}

model ExercisePrescription {
  id            String               @id @default(cuid())
  patientId     String
  therapistId   String
  appointmentId String?
  title         String
  description   String?
  instructions  String?
  startDate     DateTime             @default(now())
  endDate       DateTime?
  frequency     String?
  duration      String?
  status        String               @default("ACTIVE")
  isActive      Boolean              @default(true)
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  completedAt   DateTime?
  assignments   ExerciseAssignment[]
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id])
  therapist     User                 @relation("PrescriptionTherapist", fields: [therapistId], references: [id])

  @@index([patientId, status])
  @@index([therapistId, createdAt])
  @@index([startDate, endDate])
}

model ExerciseAssignment {
  id              String               @id @default(cuid())
  prescriptionId  String
  exerciseId      String
  sets            Int?
  reps            Int?
  holdTime        Int?
  restTime        Int?
  frequency       String?
  notes           String?
  completedCount  Int                  @default(0)
  lastCompletedAt DateTime?
  painLevel       Int?
  difficulty      String?
  patientNotes    String?
  dayOfWeek       Int[]
  timeOfDay       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  exercise        Exercise             @relation(fields: [exerciseId], references: [id])
  prescription    ExercisePrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  ExerciseLog     ExerciseLog[]

  @@unique([prescriptionId, exerciseId])
  @@index([prescriptionId])
  @@index([exerciseId])
}

model ExerciseLog {
  id            String             @id @default(cuid())
  assignmentId  String
  completedAt   DateTime           @default(now())
  setsCompleted Int                @default(0)
  repsCompleted Int                @default(0)
  painLevel     Int?
  difficulty    String?
  notes         String?
  duration      Int?
  createdAt     DateTime           @default(now())
  assignment    ExerciseAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId, completedAt])
  @@index([completedAt])
}

model WhatsAppReminderLog {
  id             String      @id @default(cuid())
  appointmentId  String
  sentById       String
  sentAt         DateTime    @default(now())
  messageContent String
  status         String      @default("SENT_MANUALLY")
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  sentBy         User        @relation("WhatsAppSender", fields: [sentById], references: [id])

  @@index([appointmentId, sentAt])
  @@index([sentById, sentAt])
}

model PaymentReference {
  id              String    @id @default(cuid())
  invoiceId       String
  paymentMethod   String
  referenceNumber String?
  bankDetails     Json?
  amount          Decimal   @db.Decimal(10, 2)
  status          String    @default("PENDING")
  expiresAt       DateTime?
  confirmedById   String?
  confirmedAt     DateTime?
  notes           String?
  confirmedBy     User?     @relation("PaymentConfirmer", fields: [confirmedById], references: [id])
  invoice         Invoice   @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([paymentMethod])
}

model VideoConsultation {
  id            String      @id @default(cuid())
  appointmentId String
  videoUrl      String
  platform      String?
  password      String?
  notes         String?
  createdById   String
  createdAt     DateTime    @default(now())
  isActive      Boolean     @default(true)
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdBy     User        @relation("VideoCreator", fields: [createdById], references: [id])

  @@index([appointmentId])
  @@index([platform])
}

model AuditLog {
  id          String        @id @default(cuid())
  userId      String
  action      AuditAction
  entityType  String
  entityId    String?
  description String
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  sessionId   String?
  severity    AuditSeverity @default(INFO)
  category    AuditCategory @default(GENERAL)
  createdAt   DateTime      @default(now())
  user        User          @relation("AuditUser", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([category, severity])
}

model BackupRecord {
  id          String       @id @default(cuid())
  filename    String
  filePath    String
  size        Int
  type        BackupType   @default(FULL)
  status      BackupStatus @default(COMPLETED)
  startedAt   DateTime
  completedAt DateTime?
  duration    Int?
  triggeredBy String?
  error       String?
  checksum    String?
  includes    Json
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model UserActivity {
  id           String   @id @default(cuid())
  userId       String
  action       String
  resource     String?
  method       String?
  statusCode   Int?
  responseTime Int?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation("UserActivity", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model IntakeForm {
  id          String    @id @default(cuid())
  patientId   String
  formType    String
  title       String
  description String?
  formData    Json
  status      String    @default("pending")
  startedAt   DateTime?
  completedAt DateTime?
  pdfUrl      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  patient     Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, status])
  @@index([formType])
}

model ConsentForm {
  id            String   @id @default(cuid())
  patientId     String
  consentType   String
  consentText   String
  title         String
  signatureData String
  signedAt      DateTime
  witnessName   String?
  ipAddress     String?
  userAgent     String?
  pdfUrl        String?
  version       String   @default("1.0")
  createdAt     DateTime @default(now())
  patient       Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId, signedAt])
  @@index([consentType])
}

model MedicalFile {
  id            String       @id @default(cuid())
  patientId     String
  appointmentId String?
  fileName      String
  originalName  String
  mimeType      String
  size          Int
  data          String
  category      String
  description   String?
  uploadedById  String
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
  uploadedBy    User         @relation("MedicalFileUploader", fields: [uploadedById], references: [id])

  @@index([patientId, category])
  @@index([category, createdAt])
}

model PainMap {
  id              String       @id @default(cuid())
  patientId       String
  appointmentId   String?
  bodyView        String
  xCoordinate     Float
  yCoordinate     Float
  bodyRegion      String?
  painIntensity   Int
  painType        String
  painDescription String?
  recordedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  patient         Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@index([appointmentId])
}

model ProgressPhoto {
  id            String       @id @default(cuid())
  patientId     String
  appointmentId String?
  photoDate     DateTime
  photoType     String
  bodyPart      String?
  imageData     String
  thumbnailData String?
  notes         String?
  takenById     String
  createdAt     DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  patient       Patient      @relation(fields: [patientId], references: [id])
  takenBy       User         @relation("PhotoTaker", fields: [takenById], references: [id])

  @@index([patientId, photoDate])
  @@index([photoType])
}

model LoyaltyProfile {
  id            String   @id @default(cuid())
  patientId     String   @unique
  points        Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  tier          String   @default("BRONZE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Badge {
  id            String         @id @default(cuid())
  name          String
  description   String?
  icon          String
  criteriaType  String
  criteriaValue Int
  createdAt     DateTime       @default(now())
  PatientBadge  PatientBadge[]
}

model PatientBadge {
  id        String   @id @default(cuid())
  patientId String
  badgeId   String
  earnedAt  DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, badgeId])
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  patientId   String
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model EducationArticle {
  id               String             @id @default(cuid())
  title            String
  content          String
  videoUrl         String?
  category         String
  tags             String[]
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  PatientEducation PatientEducation[]
}

model PatientEducation {
  id          String           @id @default(cuid())
  patientId   String
  articleId   String
  viewedAt    DateTime         @default(now())
  isCompleted Boolean          @default(false)
  article     EducationArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  patient     Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, articleId])
}

model IncidentReport {
  id           String   @id @default(cuid())
  patientId    String?
  description  String
  severity     String
  date         DateTime @default(now())
  reportedById String
  createdAt    DateTime @default(now())
  patient      Patient? @relation(fields: [patientId], references: [id])
  reportedBy   User     @relation("IncidentReporter", fields: [reportedById], references: [id])
}

model TreatmentProtocol {
  id                    String   @id @default(cuid())
  title                 String
  titleAr               String
  diagnosisCode         String?
  bodyRegion            String
  category              String
  description           String
  descriptionAr         String
  phases                Json
  expectedDurationWeeks Int      @default(12)
  evidenceSource        String
  precautions           String[]
  successRatePct        Int      @default(85)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([bodyRegion, category])
  @@index([isActive])
}

model InsuranceProvider {
  id                  String                   @id @default(cuid())
  name                String
  nameAr              String
  code                String                   @unique
  contactEmail        String?
  contactPhone        String?
  portalUrl           String?
  claimSubmissionType String                   @default("PORTAL")
  defaultCopayPct     Decimal                  @default(20) @db.Decimal(5, 2)
  payerId             String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  claims              InsuranceClaim[]
  policies            PatientInsurancePolicy[]

  @@index([code])
  @@index([isActive])
}

model PatientInsurancePolicy {
  id                 String            @id @default(cuid())
  patientId          String
  providerId         String
  policyNumber       String
  memberId           String?
  coveragePercentage Decimal           @default(80) @db.Decimal(5, 2)
  copayFixedAmount   Decimal           @default(0) @db.Decimal(10, 2)
  annualMaxLimit     Decimal?          @db.Decimal(10, 2)
  preAuthRequired    Boolean           @default(false)
  validFrom          DateTime          @default(now())
  validTo            DateTime
  isActive           Boolean           @default(true)
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  claims             InsuranceClaim[]
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider           InsuranceProvider @relation(fields: [providerId], references: [id])

  @@index([patientId])
  @@index([providerId])
  @@index([isActive])
}

model InsuranceClaim {
  id                   String                  @id @default(cuid())
  claimNumber          String                  @unique
  patientId            String
  providerId           String
  policyId             String?
  appointmentId        String?
  invoiceId            String?
  serviceDate          DateTime                @default(now())
  diagnosisCode        String?
  treatmentDescription String
  totalAmount          Decimal                 @db.Decimal(10, 2)
  coveredAmount        Decimal                 @db.Decimal(10, 2)
  patientCopayAmount   Decimal                 @db.Decimal(10, 2)
  status               String                  @default("SUBMITTED")
  preAuthCode          String?
  rejectionReason      String?
  submittedAt          DateTime?               @default(now())
  approvedAt           DateTime?
  paidAt               DateTime?
  notes                String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  appointment          Appointment?            @relation(fields: [appointmentId], references: [id])
  invoice              Invoice?                @relation(fields: [invoiceId], references: [id])
  patient              Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy               PatientInsurancePolicy? @relation(fields: [policyId], references: [id])
  provider             InsuranceProvider       @relation(fields: [providerId], references: [id])

  @@index([claimNumber])
  @@index([patientId])
  @@index([providerId])
  @@index([status])
}

model PatientOTP {
  id         String      @id @default(cuid())
  identifier String
  type       String
  code       String
  patientId  String?
  expiresAt  DateTime
  isUsed     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  otpRequest OtpRequest?
  patient    Patient?    @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([identifier, code])
}

model OtpRequest {
  id        String      @id @default(cuid())
  phone     String
  status    String      @default("PENDING")
  otpId     String?     @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  otp       PatientOTP? @relation(fields: [otpId], references: [id])

  @@index([status])
}

model StaffSalary {
  id                                 String   @id
  userId                             String
  baseSalary                         Decimal  @db.Decimal(10, 2)
  effectiveFrom                      DateTime @default(now())
  notes                              String?
  createdById                        String
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime
  User_StaffSalary_createdByIdToUser User     @relation("StaffSalary_createdByIdToUser", fields: [createdById], references: [id])
  User_StaffSalary_userIdToUser      User     @relation("StaffSalary_userIdToUser", fields: [userId], references: [id])

  @@index([userId])
}

